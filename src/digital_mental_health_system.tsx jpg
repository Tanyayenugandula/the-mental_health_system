// Seed Mood History
const generateInitialMoods = () => {
  const history = [];
  const today = new Date();
  for (let i = 29; i >= 0; i--) {
    const d = new Date(today);
    d.setDate(d.getDate() - i);
    const dateStr = d.toISOString().split('T')[0];
    history.push({
      date: dateStr,
      moodScore: Math.floor(Math.random() * 3) + 3, // 3 to 5
      stressLevel: Math.floor(Math.random() * 3) + 1, // 1 to 3
      note: i === 0 ? 'Felt balanced today after taking a short walk.' : 'Routine day with classes.'
    });
  }
  return history;
};


                  </div>
                </div>
                <span className="text-xs bg-slate-800 text-slate-300 px-3 py-1 rounded-full border border-slate-700">
                  You are: {userRole === 'student' ? 'Anonymous Student' : userName}
                </span>
              </div>

              {/* Messages Container */}
              <div className="flex-1 p-6 overflow-y-auto space-y-4 bg-slate-50/50">
                {chatMessages.map((msg) => {
                  const isMe = (userRole === 'student' && msg.senderRole === 'student') ||
                               (userRole === 'counselor' && msg.senderRole === 'counselor');
                  return (
                    <div key={msg.id} className={`flex flex-col ${isMe ? 'items-end' : 'items-start'}`}>
                      <div className="flex items-center gap-2 mb-1 text-[11px] text-slate-400">
                        <span className="font-semibold text-slate-600">{msg.senderName}</span>
                        <span>•</span>
                        <span>{msg.timestamp}</span>
                      </div>
                      <div className={`max-w-md p-3.5 rounded-2xl text-sm leading-relaxed ${
                        isMe 
                          ? 'bg-teal-600 text-white rounded-tr-none shadow-sm' 
                          : 'bg-white text-slate-800 border border-slate-200 rounded-tl-none shadow-sm'
                      }`}>
                        {msg.message}
                      </div>
                    </div>
                  );
                })}
              </div>

              {/* Message Input Box */}
              <form onSubmit={handleSendMessage} className="p-4 bg-white border-t border-slate-200 flex gap-2">
                <input
                  type="text"
                  value={inputMessage}
                  onChange={(e) => setInputMessage(e.target.value)}
                  placeholder={userRole === 'student' ? "Type an anonymous message..." : "Type your counselor response..."}
                  className="flex-1 px-4 py-2.5 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 bg-slate-50"
                />
                <button
                  type="submit"
                  className="px-5 py-2.5 bg-teal-600 hover:bg-teal-700 text-white rounded-xl text-sm font-medium transition-colors flex items-center gap-2 shadow-sm"
                >
                  <Send className="w-4 h-4" /> Send
                </button>
              </form>
            </div>
          </div>
        )}

        {/* ================= RESOURCE CENTER SECTION ================= */}
        {activeTab === 'resources' && (
          <div className="space-y-8 animate-fade-in">
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <h2 className="text-2xl sm:text-3xl font-bold text-slate-900">Self-Help Resource Library</h2>
                <p className="text-slate-500 text-sm">Evidence-based guides, articles, videos, and relaxation exercises.</p>
              </div>

              {userRole === 'admin' && (
                <button
                  onClick={() => {
                    setEditingResource({ title: '', category: 'Anxiety', type: 'article', description: '', content: '' });
                    setShowResourceModal(true);
                  }}
                  className="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white text-xs font-semibold rounded-xl shadow-sm flex items-center gap-2"
                >
                  <Plus className="w-4 h-4" /> Add Resource (Admin)
                </button>
              )}
            </div>

            {/* Filter and Search Bar */}
            <div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row gap-4 items-center justify-between">
              {/* Search */}
              <div className="relative w-full md:w-80">
                <Search className="w-4 h-4 absolute left-3.5 top-3 text-slate-400" />
                <input
                  type="text"
                  placeholder="Search resources..."
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  className="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-500 bg-slate-50"
                />
              </div>

              {/* Filters */}
              <div className="flex flex-wrap items-center gap-3 w-full md:w-auto">
                <div className="flex items-center gap-1.5 text-xs text-slate-500">
                  <Filter className="w-3.5 h-3.5" /> Category:
                </div>
                <select
                  value={selectedCategory}
                  onChange={(e) => setSelectedCategory(e.target.value)}
                  className="px-3 py-1.5 border border-slate-200 rounded-xl text-xs font-medium bg-slate-50 text-slate-700 focus:ring-2 focus:ring-teal-500"
                >
                  <option>All</option>
                  <option>Anxiety</option>
                  <option>Sleep</option>
                  <option>Mindfulness</option>
                  <option>Academic Stress</option>
                  <option>Depression</option>
                </select>

                <select
                  value={selectedType}
                  onChange={(e) => setSelectedType(e.target.value)}
                  className="px-3 py-1.5 border border-slate-200 rounded-xl text-xs font-medium bg-slate-50 text-slate-700 focus:ring-2 focus:ring-teal-500"
                >
                  <option value="All">All Types</option>
                  <option value="article">Articles</option>
                  <option value="video">Videos</option>
                  <option value="exercise">Exercises</option>
                </select>
              </div>
            </div>

            {/* Resource Cards Grid */}
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {filteredResources.map((res) => (
                <div key={res.id} className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between hover:shadow-md transition-all">
                  <div className="space-y-3">
                    <div className="flex items-center justify-between">
                      <span className="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-teal-50 text-teal-800 border border-teal-200">
                        {res.category}
                      </span>
                      <span className="text-xs text-slate-400 capitalize flex items-center gap-1">
                        <BookOpen className="w-3 h-3" /> {res.type}
                      </span>
                    </div>

                    <h3 className="font-bold text-slate-900 text-base leading-snug">{res.title}</h3>
                    <p className="text-xs text-slate-600 leading-relaxed">{res.description}</p>
                    <div className="p-3 bg-slate-50 rounded-xl text-xs text-slate-700 border border-slate-100">
                      <strong>Key Practice:</strong> {res.content}
                    </div>
                  </div>

                  <div className="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                    <a
                      href="#"
                      onClick={(e) => { e.preventDefault(); showToast(`Opening resource: ${res.title}`); }}
                      className="text-xs font-semibold text-teal-700 hover:text-teal-800 flex items-center gap-1"
                    >
                      Read Full Resource <ArrowRight className="w-3 h-3" />
                    </a>

                    {userRole === 'admin' && (
                      <div className="flex gap-2">
                        <button
                          onClick={() => { setEditingResource(res); setShowResourceModal(true); }}
                          className="p-1.5 text-slate-400 hover:text-teal-600 rounded-lg hover:bg-slate-100"
                        >
                          <Edit className="w-3.5 h-3.5" />
                        </button>
                        <button
                          onClick={() => handleDeleteResource(res.id)}
                          className="p-1.5 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-slate-100"
                        >
                          <Trash2 className="w-3.5 h-3.5" />
                        </button>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>

            {/* Admin Add/Edit Resource Modal */}
            {showResourceModal && (
              <div className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4">
                <div className="bg-white rounded-2xl p-6 max-w-lg w-full space-y-4 shadow-xl border border-slate-200">
                  <h3 className="text-lg font-bold text-slate-900">
                    {editingResource?.id ? 'Edit Resource' : 'Add New Resource'}
                  </h3>

                  <form onSubmit={handleSaveResource} className="space-y-3">
                    <div>
                      <label className="block text-xs font-semibold text-slate-500 uppercase mb-1">Title</label>
                      <input
                        type="text"
                        value={editingResource?.title || ''}
                        onChange={(e) => setEditingResource({ ...editingResource, title: e.target.value })}
                        className="w-full px-3 py-2 text-xs border border-slate-200 rounded-xl bg-slate-50"
                        required
                      />
                    </div>

                    <div className="grid grid-cols-2 gap-3">
                      <div>
                        <label className="block text-xs font-semibold text-slate-500 uppercase mb-1">Category</label>
                        <select
                          value={editingResource?.category || 'Anxiety'}
                          onChange={(e) => setEditingResource({ ...editingResource, category: e.target.value })}
                          className="w-full px-3 py-2 text-xs border border-slate-200 rounded-xl bg-slate-50"
                        >
                          <option>Anxiety</option>
                          <option>Sleep</option>
                          <option>Mindfulness</option>
                          <option>Academic Stress</option>
                          <option>Depression</option>
                        </select>
                      </div>
                      <div>
                        <label className="block text-xs font-semibold text-slate-500 uppercase mb-1">Type</label>
                        <select
                          value={editingResource?.type || 'article'}
                          onChange={(e) => setEditingResource({ ...editingResource, type: e.target.value })}
                          className="w-full px-3 py-2 text-xs border border-slate-200 rounded-xl bg-slate-50"
                        >
                          <option value="article">Article</option>
                          <option value="video">Video</option>
                          <option value="exercise">Exercise</option>
                        </select>
                      </div>
                    </div>

                    <div>
                      <label className="block text-xs font-semibold text-slate-500 uppercase mb-1">Description</label>
                      <textarea
                        value={editingResource?.description || ''}
                        onChange={(e) => setEditingResource({ ...editingResource, description: e.target.value })}
                        rows={2}
                        className="w-full px-3 py-2 text-xs border border-slate-200 rounded-xl bg-slate-50"
                        required
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-semibold text-slate-500 uppercase mb-1">Content / Practice Summary</label>
                      <textarea
                        value={editingResource?.content || ''}
                        onChange={(e) => setEditingResource({ ...editingResource, content: e.target.value })}
                        rows={3}
                        className="w-full px-3 py-2 text-xs border border-slate-200 rounded-xl bg-slate-50"
                        required
                      />
                    </div>

                    <div className="flex justify-end gap-3 pt-3">
                      <button
                        type="button"
                        onClick={() => setShowResourceModal(false)}
                        className="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl"
                      >
                        Cancel
                      </button>
                      <button
                        type="submit"
                        className="px-4 py-2 text-xs font-semibold bg-teal-600 text-white hover:bg-teal-700 rounded-xl"
                      >
                        Save Resource
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            )}
          </div>
        )}

        {/* ================= ADMIN ANALYTICS DASHBOARD ================= */}
        {activeTab === 'admin' && userRole === 'admin' && (
          <div className="space-y-8 animate-fade-in">
            <div className="bg-teal-900 text-white p-6 rounded-2xl shadow-sm space-y-1">
              <div className="flex items-center gap-2">
                <Shield className="w-5 h-5 text-teal-300" />
                <h2 className="text-xl font-bold">Privacy-Preserving Institutional Dashboard</h2>
              </div>
              <p className="text-xs text-teal-200">
                Notice: All metrics are strictly anonymized & aggregated across campus student demographics. No individual health entries are accessible.
              </p>
            </div>

            {/* Aggregated Key Metrics */}
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-1">
                <span className="text-xs font-semibold text-slate-400 uppercase">Active Students</span>
                <h3 className="text-2xl font-bold text-slate-900">{adminStats.totalUsers}</h3>
                <p className="text-[11px] text-emerald-600 font-medium">+12% check-ins this month</p>
              </div>

              <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-1">
                <span className="text-xs font-semibold text-slate-400 uppercase">Campus Avg Mood</span>
                <h3 className="text-2xl font-bold text-slate-900">{adminStats.avgMood} / 5.0</h3>
                <p className="text-[11px] text-slate-500">Stable benchmark</p>
              </div>

              <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-1">
                <span className="text-xs font-semibold text-slate-400 uppercase">Campus Avg Stress</span>
                <h3 className="text-2xl font-bold text-slate-900">{adminStats.avgStress} / 5.0</h3>
                <p className="text-[11px] text-amber-600 font-medium">Spike during midterms</p>
              </div>

              <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-1">
                <span className="text-xs font-semibold text-slate-400 uppercase">Appointments Booked</span>
                <h3 className="text-2xl font-bold text-slate-900">{appointments.length}</h3>
                <p className="text-[11px] text-teal-600 font-medium">100% counselor response rate</p>
              </div>
            </div>

            {/* Severity Distribution & Aggregated Recharts */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
              <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <h3 className="text-base font-semibold text-slate-900 mb-4">Assessment Severity Distribution</h3>
                <div className="h-64">
                  <ResponsiveContainer width="100%" height="100%">
                    <BarChart data={adminStats.severityDist}>
                      <CartesianGrid strokeDasharray="3 3" stroke="#F1F5F9" />
                      <XAxis dataKey="name" tick={{ fontSize: 12 }} />
                      <YAxis tick={{ fontSize: 12 }} />
                      <Tooltip />
                      <Bar dataKey="count" fill="#0D9488" radius={[8, 8, 0, 0]} />
                    </BarChart>
                  </ResponsiveContainer>
                </div>
              </div>

              <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <h3 className="text-base font-semibold text-slate-900 mb-4">Resource Engagement Breakdown</h3>
                <div className="h-64 flex items-center justify-center">
                  <ResponsiveContainer width="100%" height="100%">
                    <PieChart>
                      <Pie
                        data={[
                          { name: 'Anxiety', value: 40, color: '#0D9488' },
                          { name: 'Sleep', value: 25, color: '#0EA5E9' },
                          { name: 'Mindfulness', value: 20, color: '#F59E0B' },
                          { name: 'Academic Stress', value: 15, color: '#8B5CF6' }
                        ]}
                        cx="50%"
                        cy="50%"
                        innerRadius={60}
                        outerRadius={80}
                        paddingAngle={5}
                        dataKey="value"
                      >
                        {[
                          { color: '#0D9488' },
                          { color: '#0EA5E9' },
                          { color: '#F59E0B' },
                          { color: '#8B5CF6' }
                        ].map((entry, index) => (
                          <Cell key={`cell-${index}`} fill={entry.color} />
                        ))}
                      </Pie>
                      <Tooltip />
                    </PieChart>
                  </ResponsiveContainer>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* ================= FULL STACK CODE & ARCHITECTURE INSPECTOR ================= */}
        {activeTab === 'code' && (
          <div className="space-y-8 animate-fade-in">
            <div>
              <h2 className="text-2xl sm:text-3xl font-bold text-slate-900">Full-Stack Codebase & Architecture Browser</h2>
              <p className="text-slate-500 text-sm">
                Inspect the production Node.js, Express REST routes, Mongoose models, Socket.io real-time chat setup, and deployment guide.
              </p>
            </div>

            <div className="grid grid-cols-1 lg:grid-cols-4 gap-6">
              {/* File Selector Sidebar */}
              <div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm space-y-2">
                <h3 className="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 px-2">Backend Code Structure</h3>
                {CODE_FILES.map((file, idx) => (
                  <button
                    key={file.path}
                    onClick={() => setSelectedCodeIndex(idx)}
                    className={`w-full text-left px-3 py-2.5 rounded-xl text-xs font-mono transition-colors flex items-center gap-2 ${
                      selectedCodeIndex === idx 
                        ? 'bg-slate-900 text-teal-400 font-semibold' 
                        : 'text-slate-600 hover:bg-slate-100'
                    }`}
                  >
                    <FileText className="w-3.5 h-3.5 text-slate-400 shrink-0" />
                    <span className="truncate">{file.path}</span>
                  </button>
                ))}
              </div>

              {/* Code Viewer */}
              <div className="lg:col-span-3 bg-slate-900 text-slate-100 rounded-2xl p-6 font-mono text-xs overflow-x-auto shadow-md border border-slate-800">
                <div className="flex items-center justify-between pb-4 mb-4 border-b border-slate-800 text-slate-400">
                  <span className="font-semibold text-teal-400">{CODE_FILES[selectedCodeIndex].path}</span>
                  <span className="text-[10px] bg-slate-800 px-2 py-1 rounded text-slate-300">{CODE_FILES[selectedCodeIndex].title}</span>
                </div>
                <pre className="leading-relaxed whitespace-pre">
                  {CODE_FILES[selectedCodeIndex].code}
                </pre>
              </div>
            </div>

            {/* Deployment Steps */}
            <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
              <h3 className="text-lg font-bold text-slate-900 flex items-center gap-2">
                <Globe className="w-5 h-5 text-teal-600" /> Deployment Instructions (Render + Vercel + MongoDB Atlas)
              </h3>

              <div className="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
                <div className="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                  <span className="font-bold text-slate-900 text-sm">1. MongoDB Atlas Setup</span>
                  <p className="text-slate-600">Create a free cluster on MongoDB Atlas. Add Database User and set Network Access IP to 0.0.0.0/0. Copy the MONGODB_URI connection string.</p>
                </div>

                <div className="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                  <span className="font-bold text-slate-900 text-sm">2. Deploy Backend to Render</span>
                  <p className="text-slate-600">Push /backend to GitHub. Create a Render Web Service. Set Environment Variables: MONGODB_URI, JWT_SECRET, PORT=5000, CLIENT_URL.</p>
                </div>

                <div className="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                  <span className="font-bold text-slate-900 text-sm">3. Deploy Frontend to Vercel</span>
                  <p className="text-slate-600">Import /frontend repo into Vercel. Add Environment Variable NEXT_PUBLIC_API_URL pointing to your Render backend URL.</p>
                </div>
              </div>
            </div>
          </div>
        )}

      </main>

      {}
      <footer className="bg-white border-t border-slate-200 py-6 mt-12">
        <div className="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500 space-y-2">
          <p>MindBridge Student Mental Health & Psychological Support System • Confidential & Safe</p>
          <p className="text-slate-400">If you are experiencing an immediate emergency, please call 988 Suicide & Crisis Lifeline or reach out to campus security.</p>
        </div>
      </footer>
    </div>
  );
}